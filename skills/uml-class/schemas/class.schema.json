{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/local/uml-class-dsh/schemas/class.schema.json",
  "title": "UML class diagram spec",
  "description": "Input format for the uml-class skill. Validated in code by renderers/model.mjs; this schema is for editors and readers.",
  "type": "object",
  "required": ["schemaVersion", "classes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "description": "Заголовок страницы и диаграммы" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "description": "Уникальный идентификатор, используется в связях"
        },
        "name": { "type": "string", "minLength": 1 },
        "stereotype": {
          "enum": ["class", "interface", "abstract", "enum", "record"],
          "description": "Не задан — рисуется как обычный класс"
        },
        "package": { "type": "string", "description": "Должен совпадать с packages[].id" },
        "fields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Строки рисуются как есть, порядок сохраняется"
        },
        "properties": { "type": "array", "items": { "type": "string" } },
        "events": {
          "type": "array",
          "items": { "type": "string" },
          "description": "События и делегаты — отдельная секция, не свойства"
        },
        "constructors": { "type": "array", "items": { "type": "string" } },
        "methods": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relation": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": {
          "enum": [
            "inheritance",
            "realization",
            "dependency",
            "association",
            "composition",
            "aggregation"
          ]
        },
        "label": { "type": "string" },
        "fromMultiplicity": { "type": "string" },
        "toMultiplicity": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "required": ["id", "label", "classes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Каждый класс может входить только в один пакет"
        }
      }
    }
  }
}
